---
import Layout from '../../layouts/Layout.astro';
import { getAllArtists } from '../../lib/queries';

export const prerender = false;

const artists = await getAllArtists();
---
<Layout title="Artists">
  <h1>Artists</h1>

  <input type="text" id="artist-search" class="search-input" placeholder="Search artists…" />

  <ul class="artist-grid" id="artist-grid">
    {artists.map((a) => (
      <li data-name={a.name.toLowerCase()}>
        <a class="artist-card" href={`/artists/${a.slug}`}>
          {a.image_url && <img src={a.image_url} alt={a.name} loading="lazy" />}
          <span>{a.name}</span>
        </a>
      </li>
    ))}
  </ul>
  <p class="search-empty" id="artist-search-empty">No artists match "<span></span>".</p>
  <button type="button" class="load-more" id="artist-load-more">Load more</button>
</Layout>

<style>
  .load-more {
    display: none;
    margin: 1.75rem auto 0;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    padding: 0.6rem 1.4rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface);
    color: var(--color-ink);
    cursor: pointer;
  }
  .load-more:hover { border-color: var(--color-ink); }
</style>

<script>
  const PAGE_SIZE = 30;

  const input = document.getElementById('artist-search') as HTMLInputElement;
  const items = [...document.querySelectorAll<HTMLLIElement>('#artist-grid > li')];
  const empty = document.getElementById('artist-search-empty')!;
  const emptyQuery = empty.querySelector('span')!;
  const loadMoreBtn = document.getElementById('artist-load-more') as HTMLButtonElement;

  let visibleCount = PAGE_SIZE;

  function render() {
    const query = input.value.trim().toLowerCase();
    const isSearching = query.length > 0;
    const matched = items.filter((item) => !query || item.dataset.name!.includes(query));
    const toShow = isSearching ? matched : matched.slice(0, visibleCount);
    const visibleSet = new Set(toShow);
    for (const item of items) item.style.display = visibleSet.has(item) ? '' : 'none';

    empty.style.display = matched.length === 0 ? 'block' : 'none';
    emptyQuery.textContent = query;

    loadMoreBtn.style.display = !isSearching && matched.length > visibleCount ? 'block' : 'none';
  }

  input.addEventListener('input', render);
  loadMoreBtn.addEventListener('click', () => {
    visibleCount += PAGE_SIZE;
    render();
  });

  render();
</script>
